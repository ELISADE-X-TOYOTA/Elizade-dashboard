# Baked into the production bundle at build time.
#
# The board ships with built-in sample data, so it needs none of this to run —
# these settings only matter once you switch it to a real backend, with
# VITE_DEMO_DATA=false here or ?live in the URL.
#
# When you do switch: a static build has no dev proxy, so this is the address
# the kiosk calls. Pointed at localhost, a deployed board would try to reach the
# viewer's OWN machine. Set the real origin before it leaves this laptop, and
# add whatever origin serves the build to the backend's CORS_ORIGINS, or the
# browser blocks the response before the app sees it.
#
#   VITE_API_URL=https://elizade-backend-api-production.up.railway.app
VITE_API_URL=http://localhost:8000

# Sample data is on unless this is explicitly "false".
VITE_DEMO_DATA=true
