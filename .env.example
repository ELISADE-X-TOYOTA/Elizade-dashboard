# Dev (`npm run dev`): leave empty. Requests stay same-origin on /api and Vite
# proxies them to the deployed backend, so CORS never comes into it. Point the
# proxy elsewhere with API_PROXY_TARGET (see vite.config.ts).
VITE_API_URL=

# Develop against a backend running on your machine:
# API_PROXY_TARGET=http://localhost:8000

# Production builds read .env.production, which is committed.
