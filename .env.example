# The board runs standalone on built-in sample data by default — `npm run dev`
# and it works, no backend required. Nothing in this file is needed for that.

# Sample data is ON unless this is explicitly "false". Use ?live in the URL to
# hit a real backend without rebuilding (and ?demo to force sample data back on).
# VITE_DEMO_DATA=false

# Only read when sample data is off.
# Dev: leave empty. Requests stay same-origin on /api and Vite proxies them to
# http://localhost:8000, so CORS never comes into it. Point the proxy elsewhere
# with API_PROXY_TARGET (see vite.config.ts).
VITE_API_URL=

# Proxy to the deployed backend instead of your local one:
# API_PROXY_TARGET=https://elizade-backend-api-production.up.railway.app

# Production builds read .env.production, which is committed.
